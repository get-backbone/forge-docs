      "post" : {
        "summary" : "Refresh a user access token",
        "operationId" : "refreshUserToken",
        "tags" : [ "Auth" ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : { }
              }
            }
          },
          "400" : {
            "description" : "Bad Request"
          }
        }
      }
    },
    "/auth/register" : {
      "post" : {
        "summary" : "Register a new actor account",
        "operationId" : "register",
        "tags" : [ "Auth" ],
