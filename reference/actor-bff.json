      }
    },
    "/auth/linkedin/login" : {
      "get" : {
        "summary" : "Start LinkedIn login (redirect)",
        "operationId" : "linkedInLogin",
        "tags" : [ "Auth" ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : { }
              }
            }
          }
        }
      }
    },
